graph TB
    %% ── Styles ──
    classDef foundation fill:#f5f5f5,stroke:#666,stroke-width:1.5px,color:#333,font-size:14px
    classDef engine fill:#00B07C15,stroke:#00B07C,stroke-width:2px,color:#00B07C,font-size:14px
    classDef result fill:#0395D815,stroke:#0395D8,stroke-width:2px,color:#0395D8,font-size:14px
    classDef verify fill:#8B000015,stroke:#8B0000,stroke-width:2px,color:#8B0000,font-size:14px

    %% ═══ Foundation: Rules + Evidence ═══
    subgraph FOUNDATION["<b>📚 知识基础 / Knowledge Foundation</b>"]
        direction LR
        RULES["<b>44 条 YAML 规则</b><br/>DEG 5 + PanCancer 16 + scRNA 22<br/>独立演化, 加规则不改代码"]
        EVIDENCE["<b>文献锚点 / Evidence Anchors</b><br/>每条评分 → 具体 PMID<br/>Conesa 2016, Schurch 2016,<br/>Squair 2021, Hafemeister 2019..."]
    end
    class RULES,EVIDENCE foundation

    %% ═══ Engine: 7-Step Pipeline ═══
    subgraph ENGINE["<b>⚙️ 审计引擎 / Audit Engine</b> (&lt;500 lines Python)"]
        direction LR
        PIPELINE["<b>7-Step Pipeline</b><br/>Parse → Match → Evaluate<br/>Detect Conflicts → Aggregate<br/>Trace Errors → Generate Report"]
        LEVELS["<b>4-Level Scoring</b><br/>L1 决策级 · L2 流程级<br/>L3 结论级 · L4 一致性级"]
    end
    class PIPELINE,LEVELS engine

    %% ═══ Results: Three Acts ═══
    subgraph RESULTS["<b>📊 审计产出 / Audit Output</b> — 20 trajectories, 125 decision points"]
        direction LR
        ACT1["<b>Act 1 · DEG</b><br/>5 decisions<br/>+ 2 edge cases"]
        ACT2["<b>Act 2 · PanCancer</b><br/>16 decisions<br/>+ L3/L4 + 4 edges"]
        ACT3["<b>Act 3 · scRNA</b><br/>12-23 decisions<br/>+ CellVoyager real<br/>+ 3 TME types"]
    end
    class ACT1,ACT2,ACT3 result

    %% ═══ Verification Loop ═══
    subgraph VERIFY["<b>🔍 独立验证 / Independent Verification</b> — 4 rounds (R0-R3), 4 experts x 2 reviews"]
        direction LR
        R0["R0 · 真值锚定<br/>Spearman ρ=0.97"]
        R1["R1 · 酵母基准<br/>correct 85 vs error 0"]
        R2["R2 · 跨基因<br/>CSTB/TP53/CD274 零差异"]
        R3["R3 · 合规+权威<br/>4/4 detection"]
    end
    class R0,R1,R2,R3 verify

    %% ── Flow ──
    FOUNDATION --> ENGINE
    ENGINE --> RESULTS
    RESULTS -.->|"findings feed back"| FOUNDATION
    VERIFY -.->|"validates trustworthiness"| ENGINE
